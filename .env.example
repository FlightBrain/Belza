SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_BOT_USER_ID=U0AR6BMV46B
SLACK_CHANNEL_ID=C093Z82DK18

# Core reply model (Groq, OpenAI-compatible API)
GROQ_API_KEY=gsk_your-groq-key-here

# Vercel KV - REQUIRED. Without both of these, user profiles, channel log,
# and reminders silently fall back to per-instance memory and lose all state
# on every cold start.
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token-here

BRAINTRUST_API_KEY=your-braintrust-api-key-here

# Notion is reached ONLY via the relay (a Notion AI agent in a Slack channel).
# There is deliberately no NOTION_API_KEY - see README, "one Notion path".
CRON_SECRET=generate-with-openssl-rand-hex-32

# Relay: route questions through a Notion agent via a Slack channel
RELAY_ENABLED=false
RELAY_CHANNEL_ID=C0AQCKR9M2S
RELAY_TIMEOUT_MS=20000
RELAY_POLL_INTERVAL_MS=2000
RELAY_REQUEST_PREFIX=[CLAUDESINGTON_RELAY_REQUEST]
RELAY_BOT_USER_IDS=
RELAY_DEBUG_LOGGING=false
